{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/contracts/research/public-article.v1.schema.json",
  "title": "Public Research Article View v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "area_slug",
    "title",
    "summary",
    "visibility",
    "state",
    "version"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "area_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "visibility": {
      "const": "public-approved"
    },
    "state": {
      "enum": [
        "active-research",
        "published",
        "updated",
        "superseded"
      ]
    },
    "version": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
